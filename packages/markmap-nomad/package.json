{
  "name": "markmap-nomad",
  "version": "0.2.1",
  "description": "NotebookLM-style read-only mind maps from Markdown or YAML",
  "license": "MIT",
  "keywords": [
    "markmap",
    "markdown",
    "mindmap",
    "yaml"
  ],
  "homepage": "https://github.com/paco-barreras/markmap-nomad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paco-barreras/markmap-nomad.git",
    "directory": "packages/markmap-nomad"
  },
  "bugs": {
    "url": "https://github.com/paco-barreras/markmap-nomad/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "markmap-nomad": "cli.mjs"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "cli.mjs",
    "dist"
  ],
  "scripts": {
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "build:types": "tsc",
    "build:js": "vite build",
    "build": "node ../../scripts/build-prototype-deps.mjs && del-cli dist tsconfig.tsbuildinfo && tsc && vite build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "del-cli": "^6.0.0",
    "markmap-common": "workspace:*",
    "markmap-lib": "workspace:*",
    "markmap-view": "workspace:*",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "yaml": "^2.5.1"
  }
}
